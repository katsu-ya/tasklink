<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">

        <% if @task.errors.any? %>
          <div class="alert alert-danger">
            <ul>
              <% @task.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>


        <%= form_with model: @task do |f| %>

          <div class="mb-4">
          
            <%= f.label :title, class: "block font-bold" %>
            <%= f.text_field :title, class: "w-full border rounded px-3 py-2" %>
          </div>

          <div class="mb-4">
            <%= f.label :content, class: "block font-bold" %>
            <%= f.text_area :description, class: "w-full border rounded px-3 py-2" %>
          </div>

          <div class="mb-4">
            <%= f.label :status, "ステータス", class: "block font-bold" %>
            <%= f.select :status,
              [["未着手", "todo"], ["作業中", "doing"],["完了", "done"]],
            {},
            class: "w-full border rounded px-3 py-2" %>
          </div>

          <div>
           <%= f.label :deadline, "期限",
            class: "block text-semibold font-bold text-gray-700 mb-1" %>

          <%= f.date_field :deadline,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring focus:ring-blue-200" %>
          </div>

            <%= f.submit "投稿", class: "bg-green-500 text-white px-4 py-2 rounded mt-4" %>
          <% end %>
      </div>
    </div>
  </div>
</div>
