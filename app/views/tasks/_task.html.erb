    <div id="task_<%= task.id %>"
     data-controller="remove highlight confetti"
     data-id="<%= task.id %>"
     data-status="<%= task.status %>"

         class="relative
           <%= task.status == "done" ? "bg-green-50 border border-green-200" : "bg-white" %>
           p-4 rounded-xl shadow-md h-full flex flex-col justify-between
           transition-all duration-300 transform hover:shadow-xl hover:-translate-y-1 active:scale-95

           
           <%#= 'text-gray-400 line-through' if task.status == "done" %>

           <%= 'opacity-0 translate-y-6 scale-95 bg-yellow-100 shadow-2xl' if task.instance_variable_get(:@newly_created) %>

           <%= 'border-2 border-red-300 bg-red-50' if task.deadline.present? && task.deadline < Date.current && task.status != "done" %>

           <%= 'ring-2 ring-yellow-200' if task.deadline == Date.current && task.status != "done" %>">
           

           <div class="flex items-center">

             <%= form_with model: task, url: task_path(task), method: :patch do |f| %>

        <% end %>
    
      </div>

      <!-- 左側（タイトル・説明） -->
        <div>
          <h2 class="!text-base !font-semibold text-gray-800 <%= 'line-through text-gray-400' if task.status == 'done' %>">
            <%= task.title %>
          </h2>
          <p class="text-gray-600 text-sm"><%= task.description %></p>
          <p class="text-xs text-gray-400 mb-2">
             作成日: <%= task.created_at.strftime("%Y/%m/%d") %></p>

          <% if task.team.present? %>
            <p class="text-xs text-purple-400">
              
            </p>
          <% end %>
        </div>


        <% if task.deadline.present? && task.status != "done" %>
  <div class="mt-2 text-sm font-semibold flex items-center justify-between">

    <div>
      <% if task.deadline < Date.current %>
        <span class="text-red-500">
          🔴 期限切れ
        </span>

      <% elsif task.deadline == Date.current %>
        <span class="text-yellow-500">
          🟡 今日まで
        </span>

      <% elsif task.deadline == Date.tomorrow %>
        <span class="text-blue-500">
          🔵 明日まで
        </span>

      <% else %>
        <span class="text-green-500">
          🟢 <%= task.deadline.strftime("%m/%d") %>まで
        </span>
      <% end %>
    </div>



    <% unless task.status == "done" %>
  <div class="text-xs text-gray-500">
    <% days_left = (task.deadline - Date.current).to_i %>

    <% if days_left < 0 %>
      <span class="text-red-400">
        <%= days_left.abs %>日超過
      </span>

    <% elsif days_left == 0 %>
      今日

    <% elsif days_left == 1 %>
      あと1日

    <% else %>
      あと<%= days_left %>日
    <% end %>
  </div>
<% end %>


  </div>
<% end %>

        <!-- 右側（ステータス・ボタン） -->
        
        <div class="flex items-center gap-3 whitespace-nowrap mt-3">

          <!-- ステータス -->
          <span class="px-2 py-1 text-sm rounded
            <%= case task.status
            when "todo" then "bg-gray-300"
            when "doing" then "bg-blue-300"
            when "done" then "bg-green-300"
            end %>">
          <%= case task.status
            when "todo" then "📝 未着手"
            when "doing" then "🔥 作業中"
            when "done" then "✔ 完了"
            end %>
          </span>

          <%
            next_status =
            case task.status
            when "todo" then "doing"
            when "doing" then "done"
            when "done" then "todo"
            end
          %>

      <!-- ボタン -->
  <%= form_with model: task do |f| %>
    <%= f.hidden_field :status, value: next_status %>

    <%= f.submit "▶ ステータス変更",
      class: "bg-blue-100 text-blue-600 px-2 py-0.5 text-xs scale-90 rounded-full bg-gray-100 hover:bg-gray-300 transition-all duration-300" %>
  <% end %>


      <!-- 編集 -->
  <% if policy(task).update? %>
  <%= link_to edit_task_path(task),
    data: { turbo_frame: "modal" },
    class: "hover:text-blue-500 transition" do %>

    <svg xmlns="http://www.w3.org/2000/svg"
         class="w-5 h-5"
         fill="none"
         stroke="currentColor"
         viewBox="0 0 24 24">
      <path stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M11 5h2M12 20h9M16.5 3.5a2.1 2.1 0 113 3L7 19l-4 1 1-4 12.5-12.5z"/>
    </svg>

  <% end %>
<% end %>


      <!-- 削除 -->
    <% if policy(task).destroy? %>
  <%= link_to task_path(task),
    data: {
      turbo_method: :delete,
      turbo_confirm: "削除しますか？",
      action: "click->remove#fadeOutAndSubmit"
    },
    class: "hover:text-red-500" do %>

    🗑

  <% end %>
<% end %>


     </div>

 </div>