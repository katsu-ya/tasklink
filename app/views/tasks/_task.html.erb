    <div id="task_<%= task.id %>"
     data-id="<%= task.id %>"

         class="bg-white p-4 rounded-xl shadow-md h-full flex flex-col justify-between
           transition-all duration-300        
           <%= 'opacity-50 line-through' if task.status == "done" %>">

           <div class="flex items-center mb-2">

             <%= form_with model: task, url: task_path(task), method: :patch do |f| %>

        <% end %>
    
      </div>

      <!-- 左側（タイトル・説明） -->
        <div>
          <h2 class="!text-base !font-semibold text-gray-800 <%= 'line-through text-gray-400' if task.status == 'done' %>">
            <%= task.title %>
          </h2>
          <p class="text-gray-600 text-sm"><%= task.description %></p>
          <p class="text-xs text-gray-400 mb-2">
             作成日: <%= task.created_at.strftime("%Y/%m/%d") %></p>
        </div>

        <!-- 右側（ステータス・ボタン） -->
        
        <div class="flex items-center gap-2 whitespace-nowrap mt-3">

          <!-- ステータス -->
          <span class="px-2 py-1 text-sm rounded
            <%= case task.status
            when "todo" then "bg-gray-300"
            when "doing" then "bg-blue-300"
            when "done" then "bg-green-300"
            end %>">
          <%= case task.status
            when "todo" then "📝 未着手"
            when "doing" then "🔥 作業中"
            when "done" then "✔ 完了"
            end %>
          </span>

          <%
            next_status =
            case task.status
            when "todo" then "doing"
            when "doing" then "done"
            when "done" then "todo"
            end
          %>

      <!-- ボタン -->
  <%= form_with model: task do |f| %>
    <%= f.hidden_field :status, value: next_status %>

    <%= f.submit "▶ ステータス変更",
      class: "bg-blue-100 text-blue-600 px-2 py-0.5 text-xs scale-90 rounded-full bg-gray-100 hover:bg-gray-200 transition" %>
  <% end %>

      <!-- 編集 -->
  <%= link_to edit_task_path(task),
    data: { turbo_frame: "modal" },
    class: "hover:text-blue-500 transition" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M11 5h2M12 20h9M16.5 3.5a2.1 2.1 0 113 3L7 19l-4 1 1-4 12.5-12.5z"/>
    </svg>
  <% end %>

      <!-- 削除 -->
    <%= link_to task_path(task),
        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
        class: "hover:text-red-500" do %>
      🗑
    <% end %>

     </div>

 </div>