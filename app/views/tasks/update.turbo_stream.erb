<turbo-stream action="replace" target="tasks">
  <template>
    <div id="tasks"
         data-controller="sortable"
         class="grid grid-cols-3 gap-6">
      <%= render partial: "tasks/task", formats: [:html], collection: @tasks %>
    </div>
  </template>
</turbo-stream>


<turbo-stream action="update" target="modal">
  <template></template>
</turbo-stream>


<turbo-stream action="replace" target="flash">
  <template>
    <div id="flash">
      <% flash.each do |key, message| %>
        <div class="flash-message bg-green-100 text-green-700 px-4 py-2 rounded mb-4"
             data-controller="flash">
          <%= message %>
        </div>
      <% end %>
    </div>
  </template>
</turbo-stream>

<% flash.discard %>


