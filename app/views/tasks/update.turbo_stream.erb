<turbo-stream action="replace" target="task_<%= @task.id %>">
  <template>
    <%= render partial: "tasks/task", formats: [:html], locals: { task: @task } %>
  </template>
</turbo-stream>


<turbo-stream action="update" target="modal">
  <template></template>
</turbo-stream>


<turbo-stream action="replace" target="flash">
  <template>
    <div id="flash">
      <% flash.each do |key, message| %>
        <div class="flash-message bg-green-100 text-green-700 px-4 py-2 rounded mb-4">
          <%= message %>
        </div>
      <% end %>
    </div>
  </template>
</turbo-stream>

<% flash.discard %>


