<div class="max-w-5xl mx-auto mt-1">



  <!-- タイトル -->
  <h1 class="text-2xl font-bold mb-2">
    <% if params[:keyword].present? %>
      「<%= params[:keyword] %>」の検索結果
    <% else %>
      タスク一覧
    <% end %>
  </h1>

  <!-- 新規作成 -->
  <%= link_to "＋ 新規投稿", new_task_path,
    data: { turbo_frame: "modal" },
      class: "inline-block bg-blue-500 text-white px-4 py-2 rounded mb-4 hover:bg-blue-600 mt-2" %>


<div class="flex items-center justify-between mb-6">

  <!-- 検索 -->
  <div class="flex gap-2 w-full max-w-xl">
    <%= form_with url: tasks_path, method: :get, local: true, class: "flex gap-2 w-full" do |f| %>
      <%= f.text_field :keyword,
          placeholder: "タイトル検索",
          class: "border rounded px-3 py-2 w-full" %>
      <button class="bg-gray-400 text-white px-4 py-2 rounded whitespace-nowrap">
        検索
      </button>
    <% end %>


<div class="w-24">
    <% if params[:keyword].present? %>
      <%= link_to "全て表示", tasks_path,
          class: "px-4 py-2 border rounded hover:bg-gray-100 whitespace-nowrap relative top-[7px]" %>
    <% end %>
</div>


</div>


  <div class="flex gap-3 mb-4">

  <%= link_to "すべて",
      tasks_path(status: "all"),
      class: "px-3 py-1 rounded text-sm #{params[:status] == 'all' || params[:status].nil? ? 'bg-blue-500 text-white' : 'bg-gray-100'}" %>

  <%= link_to "未完了",
      tasks_path(status: "todo"),
      class: "px-3 py-1 rounded text-sm #{params[:status] == 'todo' ? 'bg-blue-500 text-white' : 'bg-gray-100'}" %>

  <%= link_to "完了",
      tasks_path(status: "done"),
      class: "px-3 py-1 rounded text-sm #{params[:status] == 'done' ? 'bg-blue-500 text-white' : 'bg-gray-100'}" %>

</div>

</div>


  <!-- タスク一覧 -->
  <% if @tasks.any? %>
    <div id="tasks" class="grid grid-cols-3 gap-6"
     data-controller="sort">

      <% @tasks.each do |task| %>
  <%= render task %>
<% end %>

      
    </div>
  <% else %>

    <div class="text-center mt-10 text-gray-500">
      <% if params[:keyword].present? %>
        該当するタスクがありません
      <% else %>
        タスクがまだありません
      <% end %>
    </div>

  <% end %>

  <!-- ページネーション -->
  <div class="flex justify-center mt-8">
    <%= paginate @tasks %>
  </div>

</div>





