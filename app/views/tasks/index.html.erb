<div class="max-w-5xl mx-auto mt-10">

<div class="flex gap-3 mb-4">

  <%= link_to "すべて",
      tasks_path(status: "all"),
      class: "px-3 py-1 rounded text-sm #{params[:status] == 'all' || params[:status].nil? ? 'bg-blue-500 text-white' : 'bg-gray-100'}" %>

  <%= link_to "未完了",
      tasks_path(status: "todo"),
      class: "px-3 py-1 rounded text-sm #{params[:status] == 'todo' ? 'bg-blue-500 text-white' : 'bg-gray-100'}" %>

  <%= link_to "完了",
      tasks_path(status: "done"),
      class: "px-3 py-1 rounded text-sm #{params[:status] == 'done' ? 'bg-blue-500 text-white' : 'bg-gray-100'}" %>

</div>

  <!-- タイトル -->
  <h1 class="text-2xl font-bold mb-6">
    <% if params[:keyword].present? %>
      「<%= params[:keyword] %>」の検索結果
    <% else %>
      タスク一覧
    <% end %>
  </h1>

  <!-- 新規作成 -->
  <%= link_to "＋ 新規投稿", new_task_path,
      class: "inline-block bg-blue-500 text-white px-4 py-2 rounded mb-4 hover:bg-blue-600" %>

  <!-- 検索 -->
  <div class="flex gap-2 mb-6">
    <%= form_with url: tasks_path, method: :get, local: true, class: "flex gap-2 w-full" do |f| %>
      <%= f.text_field :keyword,
          placeholder: "タイトル検索",
          class: "border rounded px-3 py-2 w-full" %>
      <button class="bg-gray-400 text-white px-4 py-2 rounded whitespace-nowrap">
        検索
      </button>
    <% end %>

    <% if params[:keyword].present? %>
      <%= link_to "全て表示", tasks_path,
          class: "px-4 py-2 border rounded hover:bg-gray-100" %>
    <% end %>
  </div>

  <!-- タスク一覧 -->
  <% if @tasks.any? %>
    <div class="grid grid-cols-3 gap-6">

      <% @tasks.each do |task| %>
         <div class="bg-white p-4 rounded-xl shadow-md hover:shadow-xl transition
              <%= 'opacity-50 line-through' if task.completed %>">

         <div class="flex items-center mb-2">
          <%= form_with model: task, local: true do |f| %>

          <% if task.completed %>
            <%= f.hidden_field :completed, value: false %>
            <%= f.submit "✔ 完了済み",
              class: "bg-green-100 text-green-600 px-2 py-0.5 rounded transition",
              style: "font-size: 13px;"  %>
          <% else %>
            <%= f.hidden_field :completed, value: true %>
            <%= f.submit "✔ 完了にする",
              class: "bg-gray-100 hover:bg-gray-200 text-gray-700 px-2 py-0.5 rounded transition",
              style: "font-size: 13px;" %>
          <% end %>

        <% end %>
    
      </div>


      <!-- 左側（タイトル・説明） -->
        <div>
          <h2 class="!text-base !font-semibold text-gray-800"><%= task.title %></h2>
          <p class="text-gray-600 text-sm"><%= task.description %></p>
          <p class="text-xs text-gray-400 mb-2">
             作成日: <%= task.created_at.strftime("%Y/%m/%d") %></p>
        </div>

        <!-- 右側（ステータス・ボタン） -->
        <div class="flex items-center gap-3 whitespace-nowrap">

          <!-- ステータス -->
          <span class="px-2 py-1 text-xs rounded
            <%= case task.status
            when "todo" then "bg-gray-300"
            when "doing" then "bg-blue-300"
   
            end %>">
          <%= case task.status
            when "todo" then "📝 未着手"
            when "doing" then "🔥 作業中"
            end %>
          </span>

      <!-- ボタン -->



      <!-- 編集 -->
  <%= link_to edit_task_path(task), class: "hover:text-blue-500 transition" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M11 5h2M12 20h9M16.5 3.5a2.1 2.1 0 113 3L7 19l-4 1 1-4 12.5-12.5z"/>
    </svg>
  <% end %>



      <!-- 削除 -->
    <%= link_to task_path(task),
        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
        class: "hover:text-red-500" do %>
      🗑
    <% end %>

     </div>


     
   <% end %>
      
    </div>
  <% else %>

    <div class="text-center mt-10 text-gray-500">
      <% if params[:keyword].present? %>
        該当するタスクがありません
      <% else %>
        タスクがまだありません
      <% end %>
    </div>

  <% end %>

  <!-- ページネーション -->
  <div class="flex justify-center mt-8">
    <%= paginate @tasks %>
  </div>

</div>



