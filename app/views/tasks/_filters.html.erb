


<div id="filters"
     class="flex flex-wrap gap-2">

  <%= link_to "すべて",
      tasks_path(status: "all"),
      class: "px-2.5 py-2 rounded-full shrink-0 text-sm #{params[:status] == 'all' || params[:status].nil? ? 'bg-blue-500 text-white' : 'bg-gray-100 hover:bg-gray-200 transition-all whitespace-nowrap duration-300 hover:scale-105'}" %>

  <%= link_to "📝 未着手（#{@todo_count}）",
      tasks_path(status: "todo"),
      class: "px-2.5 py-2 rounded-full shrink-0 text-sm #{params[:status] == 'todo' ? 'bg-blue-500 text-white' : 'bg-gray-100 hover:bg-gray-200 transition-all whitespace-nowrap duration-300 hover:scale-105'}" %>

  <%= link_to "🔥 作業中（#{@doing_count}）",
      tasks_path(status: "doing"),
      class: "px-2.5 py-2 rounded-full shrink-0 text-sm #{params[:status] == 'doing' ? 'bg-blue-500 text-white' : 'bg-gray-100 hover:bg-gray-200 transition-all whitespace-nowrap duration-300 hover:scale-105'}" %>

  <%= link_to "✔ 完了（#{@done_count}）",
      tasks_path(status: "done"),
      class: "px-2.5 py-2 rounded-full shrink-0 text-sm #{params[:status] == 'done' ? 'bg-blue-500 text-white' : 'bg-gray-100 hover:bg-gray-200 transition-all whitespace-nowrap duration-300 hover:scale-105'}" %>

</div>