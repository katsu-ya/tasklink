<% if @task.errors.any? %>
  <div class="alert alert-danger">
    <ul>
      <% @task.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<turbo-frame id="modal">
  <h2 class="text-lg font-bold mb-4">新規投稿</h2>

  <%= render "form", task: @task %>

  <button onclick="closeModal()" class="mt-4 text-gray-500">
    閉じる
  </button>
</turbo-frame>


